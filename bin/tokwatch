#!/usr/bin/env python3
"""tokwatch CLI shim — add repo root to sys.path, delegate to tokwatch.cli.

Uses realpath so the shim still works when invoked through a symlink
(e.g. ~/.local/bin/tokwatch -> .../tokwatch/bin/tokwatch).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from tokwatch.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
