#!/usr/bin/env python3
"""Claude Code `statusLine.command` entrypoint.

Reads the per-turn stdin JSON Claude Code pipes, emits one statusline line.
Handles EPIPE (Claude Code killing the pipe on typing/debounce) gracefully.
Uses realpath so it works when invoked through a symlink.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from tokwatch.cli import statusline_main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(statusline_main())
